{
  "name": "dsh-model-retry",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "description": "按模型的重试策略：为指定 provider:model 配置重试次数、触发重试的状态码与失败类别、退避；设置页「重试策略」管理，规则落盘热生效，未匹配规则的模型保持官方缺省行为。",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
